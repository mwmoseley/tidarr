# E2E environment for the beets post-processing tests

# Beets is off in the base env; these specs need it declared as enabled so the
# settings dialog reports it and the beets code path is configured.
ENABLE_BEETS=true

# Dummy token: never used against the real Discogs API, only to prove the
# value is reported masked rather than in clear text.
DISCOGS_TOKEN=e2e-discogs-token
