# Dependencies
# Bare "node_modules" only matches the root copy - workspace copies
# (api/, app/, e2e/) must be matched explicitly or they land in the build
# context, which breaks the build on Windows (unreadable yarn .bin shims).
**/node_modules
.pnpm-store
.yarn
.npm

# Git
.git
.gitignore

# Build outputs
dist
.cache
download

# Docker
Dockerfile.*
.dockerignore
compose.override.yml
docker/mnt

# Development
Makefile
*.log*
.env.local
.vscode
.idea

# Documentation
CHANGELOG.md
README.md
*.md

# Testing
e2e
coverage

# Shared runtime data (mounted volume)
shared